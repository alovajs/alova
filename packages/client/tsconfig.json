{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./*"],
      "#/*": ["./test/*"],
      "root/*": ["../../internal/*"]
    },
    "skipLibCheck": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "typings/**/*.d.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "test/**/*.vue",
    "test/**/*.svelte"
  ]
}
