{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./*"],
      "#/*": ["./test/*"],
      "root/*": ["../../internal/*"]
    },
    "skipLibCheck": false
  },
  "include": ["src/**/*.ts", "typings", "test/**/*.ts", "test/**/*.tsx"]
}
